# ── AI Service ──────────────────────────────

# Gemini
GEMINI_API_KEY=gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB
CHROMA_PERSIST_PATH=./data/vectorstore
CHROMA_COLLECTION_NAME=products

# API
APP_NAME=RAG Product Search API
APP_VERSION=0.1.0
DEBUG=true

# LANGFUSE-OBSERVABILIDAD
LANGFUSE_SECRET_KEY=langfuse_secret_key
LANGFUSE_PUBLIC_KEY=langfuse_public_key
LANGFUSE_HOST="https://cloud.langfuse.com"

# Evaluation sample rate
EVAL_SAMPLE_RATE=0.2

# ── Backend ─────────────────────────────────

DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@postgres:5432/ragdb
AI_SERVICE_URL=http://ai-service:8000